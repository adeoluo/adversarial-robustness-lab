flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Researchers, CI jobs]):::edge
        CLI["CLI<br/>train, attack, certify"]:::edge
        Service["HTTP service<br/>/v1/attack /v1/certify"]:::core
        Validate["Request limits<br/>shape, budget, steps"]:::control
        Users --> CLI ~~~ Service --> Validate
    end

    subgraph State["Data and models"]
        direction TB
        Cifar[("CIFAR-10<br/>50k train, 10k test")]:::data
        Trainer["Training<br/>PGD-AT, TRADES, noise"]:::core
        Zoo[("Checkpoints<br/>WRN-16-2, ResNet-18")]:::data
        Cifar --> Trainer --> Zoo
    end

    subgraph Core["Attacks and certification"]
        direction TB
        Geometry["Threat model<br/>Linf, L2 projections"]:::control
        Gradient["Gradient attacks<br/>FGSM, PGD, C&W, APGD"]:::core
        Square["Square attack<br/>score based"]:::core
        Ensemble["Ensemble<br/>worst case per image"]:::core
        Smooth["Randomized smoothing<br/>Clopper-Pearson"]:::core
        Geometry --> Gradient --> Ensemble
        Square --> Ensemble ~~~ Smooth
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Verify["Threat check<br/>every batch"]:::control
        Sanity["Masking checks<br/>BPDA control"]:::obs
        Reports["Robust accuracy<br/>certified radius"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Verify --> Reports ~~~ Sanity ~~~ Metrics
    end

    Interfaces -->|images, budgets| Core
    State -.->|weights, test set| Core
    Core -->|adversarial examples| Obs
